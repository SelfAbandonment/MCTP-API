# Django 配置
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库 (默认 SQLite, 生产环境建议 PostgreSQL)
# DATABASE_URL=postgres://user:password@localhost:5432/mctp_api

# ShowDoc 文档同步 (向管理员索取)
SHOWDOC_URL=http://your-showdoc-host:port
SHOWDOC_API_KEY=your-api-key
SHOWDOC_API_TOKEN=your-api-token

# ==== django-allauth / Microsoft + Minecraft ====
MS_CLIENT_ID=<Azure 应用 ID>
MS_CLIENT_SECRET=<密钥值>
# Azure 的 Redirect URI 必须填 allauth 回调（不是旧的自定义接口）
# 本地: http://localhost:8000/accounts/microsoft/login/callback/
# 生产: https://<your-api-domain>/accounts/microsoft/login/callback/
# 前端登录成功后的落点（Vue hash 路由，必须带 #）
FRONTEND_OAUTH_CALLBACK=http://localhost:5173/#/auth/microsoft/callback
FRONTEND_BASE_URL=http://localhost:5173
# 用于加密存储 ms_refresh_token（生成: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"）
MS_TOKEN_FERNET_KEY=填写生成的_fernet_key

# ==== 跨域 / CSRF（SPA 与 API 不同端口）====
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
